# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required for invitations, validated public writes, media processing,
# and the distributed rate limiter. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use at least 32 cryptographically random characters in production.
RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret

# Optional. When true, the first screen allows creating the initial account.
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Optional application URL used for authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
