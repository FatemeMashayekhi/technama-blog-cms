# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required only for inviting authors from the admin panel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RATE_LIMIT_SECRET=replace-with-a-long-random-server-secret

# Optional. When true, the first screen allows creating the initial account.
NEXT_PUBLIC_ALLOW_SIGNUP=true

# Optional application URL used for authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
